[Unit]
Description=Brawler Market Making Strategy
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/slipstream
Environment="BRAWLER_ENV_FILE=/home/ubuntu/slipstream/config/env/.brawler"
ExecStart=/home/ubuntu/slipstream/.venv/bin/python -m slipstream.strategies.brawler.cli --config config/brawler_sol_test.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
